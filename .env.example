# Decision Engine mode: jev | fallback | rules
DECISION_ENGINE=rules

# Decision & LLM Providers (Server-side only)
JEV_API_KEY=your_jev_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Public content only; no user data stored)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service key is used strictly for offline seed/ingest scripts, NEVER exposed in client
SUPABASE_SERVICE_KEY=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
