{
  "name": "SANGYAN - Telegram Scam Analysis Workflow",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "node-telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL",
          "name": "Telegram Bot Credential"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.YOUR_SANGYAN_API_URL }}/api/integrations/n8n/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.YOUR_N8N_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"TELEGRAM\",\n  \"message\": {\n    \"id\": \"{{ $json.message.message_id }}\",\n    \"text\": \"{{ $json.message.text || '' }}\",\n    \"caption\": \"{{ $json.message.caption || '' }}\"\n  },\n  \"locale\": \"{{ $json.message.from.language_code || 'en' }}\",\n  \"provenance\": {\n    \"senderId\": \"{{ $json.message.from.id }}\",\n    \"timestamp\": \"{{ new Date().toISOString() }}\"\n  }\n}",
        "options": {}
      },
      "id": "node-sangyan-api",
      "name": "SANGYAN Canonical API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        350,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $node['Telegram Trigger'].json.message.chat.id }}",
        "text": "={{ $json.formattedMessage }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram-reply",
      "name": "Send Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        600,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL",
          "name": "Telegram Bot Credential"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "SANGYAN Canonical API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SANGYAN Canonical API": {
      "main": [
        [
          {
            "node": "Send Telegram Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
